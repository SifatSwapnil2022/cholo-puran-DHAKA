{
  "id": "./",
  "name": "Cholo Puran Dhaka",
  "short_name": "Puran Dhaka",
  "description": "A walkable 3D guide to Old Dhaka: 62 places with opening hours, fees, food prices, walking routes, festivals and a street map that works offline.",
  "lang": "en",
  "dir": "ltr",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "display_override": [
    "standalone",
    "minimal-ui"
  ],
  "orientation": "any",
  "background_color": "#0B2A21",
  "theme_color": "#006A4E",
  "categories": [
    "travel",
    "navigation"
  ],
  "icons": [
    {
      "src": "icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
